      "version": "0.2.12",
      "author": "0langa",
      "license": "MIT",
      "providers": [
        "codex",
        "claude-code",
        "kimi-code"
      ],
      "pluginRoot": "plugins/webde-access",
      "installPaths": {
        "codex": ".codex-plugin/plugin.json",
        "claude-code": ".claude-plugin/plugin.json",
        "kimi-code": "kimi.plugin.json"
      },
      "installCommands": {
        "codex": "codex plugin add webde-access@0langas-plugins",
        "claude-code": "claude plugin install webde-access@0langas-plugins",
